---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { dateKeyCentral } from '../../lib/reports';

/** UI preview only — numbers and chart are fake until you approve wiring real order data. */

const todayYmd = dateKeyCentral(Date.now());
const ytdYear = todayYmd.slice(0, 4);
const ytdFrom = `${ytdYear}-01-01`;

// Demo summary (matches sticky-note intent)
const demo = {
  totalPosts: 842,
  totalIncome: 12840,
  scheduledPosts: 310,
  scheduledIncome: 4725,
  fulfilledPosts: 532,
  fulfilledIncome: 8115,
};

function formatUsd(n: number): string {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(n);
}

function formatPosts(n: number): string {
  return `${n.toLocaleString('en-US')} posts`;
}

/** Fake cumulative daily series for chart preview (Jun–Aug style staircase). */
const chartPoints = [
  { label: 'Jun 1', posts: 0, income: 0 },
  { label: 'Jun 12', posts: 80, income: 1200 },
  { label: 'Jun 28', posts: 180, income: 2800 },
  { label: 'Jul 5', posts: 280, income: 4300 },
  { label: 'Jul 18', posts: 450, income: 6900 },
  { label: 'Jul 30', posts: 620, income: 9500 },
  { label: 'Aug 10', posts: 740, income: 11400 },
  { label: 'Aug 22', posts: 842, income: 12840 },
];

const chartW = 720;
const chartH = 280;
const pad = { top: 24, right: 56, bottom: 40, left: 48 };
const plotW = chartW - pad.left - pad.right;
const plotH = chartH - pad.top - pad.bottom;
const maxPosts = 900;
const maxIncome = 14000;

function xAt(i: number): number {
  const n = chartPoints.length - 1;
  return pad.left + (i / n) * plotW;
}
function yPosts(v: number): number {
  return pad.top + plotH - (v / maxPosts) * plotH;
}
function yIncome(v: number): number {
  return pad.top + plotH - (v / maxIncome) * plotH;
}

function stepPath(
  values: number[],
  yFn: (v: number) => number
): string {
  let d = '';
  for (let i = 0; i < values.length; i++) {
    const x = xAt(i);
    const y = yFn(values[i]!);
    if (i === 0) {
      d += `M ${x} ${y}`;
    } else {
      d += ` L ${x} ${yFn(values[i - 1]!)} L ${x} ${y}`;
    }
  }
  return d;
}

const postsPath = stepPath(
  chartPoints.map((p) => p.posts),
  yPosts
);
const incomePath = stepPath(
  chartPoints.map((p) => p.income),
  yIncome
);
---

<AdminLayout title="Reports — Admin">
  <div
    class="no-print mb-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-amber-950"
    role="status"
  >
    <strong>UI preview.</strong> Summary numbers and the chart use demo data only. Date controls are
    visual for review — real order totals are not connected yet. Tell me when you want the plumbing
    wired up.
  </div>

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Reports</h1>
    <p class="mt-1 text-sm text-slate-600">
      Order posts and income by status. Dates use America/Chicago calendar days.
    </p>
  </div>

  <!-- Date range -->
  <div class="no-print mb-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="flex flex-wrap items-end gap-3">
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="rounded bg-green-700 px-3 py-2 text-sm font-medium text-white"
          aria-pressed="true"
        >
          This YTD
        </button>
        <button
          type="button"
          class="rounded border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
          aria-pressed="false"
        >
          Custom
        </button>
      </div>
      <div class="flex flex-wrap items-end gap-3">
        <div>
          <label for="from" class="mb-1 block text-xs font-medium text-slate-600">From</label>
          <input
            id="from"
            name="from"
            type="date"
            value={ytdFrom}
            class="min-h-11 rounded border border-slate-300 px-3 py-2 text-base text-slate-900"
          />
        </div>
        <div>
          <label for="to" class="mb-1 block text-xs font-medium text-slate-600">To</label>
          <input
            id="to"
            name="to"
            type="date"
            value={todayYmd}
            class="min-h-11 rounded border border-slate-300 px-3 py-2 text-base text-slate-900"
          />
        </div>
        <button
          type="button"
          class="min-h-11 rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          Apply
        </button>
      </div>
    </div>
    <p class="mt-3 text-xs text-slate-500">
      Default: <span class="font-medium text-slate-700">{ytdFrom}</span> →
      <span class="font-medium text-slate-700">{todayYmd}</span> (year to date)
    </p>
  </div>

  <!-- Summary cards -->
  <div class="mb-10 grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Total</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">{formatPosts(demo.totalPosts)}</div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(demo.totalIncome)}
      </div>
      <p class="mt-2 text-xs text-slate-500">All orders in range</p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Scheduled</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">
        {formatPosts(demo.scheduledPosts)}
      </div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(demo.scheduledIncome)}
      </div>
      <p class="mt-2 text-xs text-slate-500">Received / scheduled — not yet fulfilled</p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Fulfilled</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">
        {formatPosts(demo.fulfilledPosts)}
      </div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(demo.fulfilledIncome)}
      </div>
      <p class="mt-2 text-xs text-slate-500">Marked fulfilled</p>
    </div>
  </div>

  <!-- Cumulative chart -->
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-semibold text-slate-900">Cumulative</h2>
      <div class="flex flex-wrap gap-4 text-sm">
        <span class="inline-flex items-center gap-2 text-slate-700">
          <span class="inline-block h-0.5 w-6 bg-slate-900" aria-hidden="true"></span>
          # Posts
        </span>
        <span class="inline-flex items-center gap-2 text-green-800">
          <span class="inline-block h-0.5 w-6 bg-green-700" aria-hidden="true"></span>
          $ Income
        </span>
      </div>
    </div>

    <div class="w-full overflow-x-auto">
      <svg
        viewBox={`0 0 ${chartW} ${chartH}`}
        class="min-w-[20rem] w-full"
        role="img"
        aria-label="Demo cumulative step chart of posts and income over time"
      >
        {/* Grid */}
        {
          [0, 0.25, 0.5, 0.75, 1].map((t) => {
            const y = pad.top + plotH * (1 - t);
            return (
              <line
                x1={pad.left}
                x2={pad.left + plotW}
                y1={y}
                y2={y}
                stroke="#e2e8f0"
                stroke-width="1"
              />
            );
          })
        }

        {/* Axes */}
        <line
          x1={pad.left}
          x2={pad.left}
          y1={pad.top}
          y2={pad.top + plotH}
          stroke="#94a3b8"
          stroke-width="1.5"
        />
        <line
          x1={pad.left + plotW}
          x2={pad.left + plotW}
          y1={pad.top}
          y2={pad.top + plotH}
          stroke="#94a3b8"
          stroke-width="1.5"
        />
        <line
          x1={pad.left}
          x2={pad.left + plotW}
          y1={pad.top + plotH}
          y2={pad.top + plotH}
          stroke="#94a3b8"
          stroke-width="1.5"
        />

        {/* Left axis labels — posts */}
        <text x={pad.left - 8} y={pad.top + 4} text-anchor="end" class="fill-slate-600 text-[10px]">
          {maxPosts}
        </text>
        <text
          x={pad.left - 8}
          y={pad.top + plotH / 2}
          text-anchor="end"
          class="fill-slate-600 text-[10px]"
        >
          {maxPosts / 2}
        </text>
        <text
          x={pad.left - 8}
          y={pad.top + plotH}
          text-anchor="end"
          class="fill-slate-600 text-[10px]"
        >
          0
        </text>
        <text
          x={14}
          y={pad.top + plotH / 2}
          text-anchor="middle"
          transform={`rotate(-90 14 ${pad.top + plotH / 2})`}
          class="fill-slate-700 text-[11px] font-medium"
        >
          # Posts
        </text>

        {/* Right axis labels — income */}
        <text
          x={pad.left + plotW + 8}
          y={pad.top + 4}
          text-anchor="start"
          class="fill-green-800 text-[10px]"
        >
          $14k
        </text>
        <text
          x={pad.left + plotW + 8}
          y={pad.top + plotH / 2}
          text-anchor="start"
          class="fill-green-800 text-[10px]"
        >
          $7k
        </text>
        <text
          x={pad.left + plotW + 8}
          y={pad.top + plotH}
          text-anchor="start"
          class="fill-green-800 text-[10px]"
        >
          $0
        </text>
        <text
          x={chartW - 12}
          y={pad.top + plotH / 2}
          text-anchor="middle"
          transform={`rotate(90 ${chartW - 12} ${pad.top + plotH / 2})`}
          class="fill-green-800 text-[11px] font-medium"
        >
          $ Income
        </text>

        {/* Step lines */}
        <path d={incomePath} fill="none" stroke="#15803d" stroke-width="2.5" />
        <path d={postsPath} fill="none" stroke="#0f172a" stroke-width="2.5" />

        {/* X labels */}
        {
          chartPoints.map((p, i) =>
            i % 2 === 0 || i === chartPoints.length - 1 ? (
              <text
                x={xAt(i)}
                y={chartH - 12}
                text-anchor="middle"
                class="fill-slate-600 text-[10px]"
              >
                {p.label}
              </text>
            ) : null
          )
        }
      </svg>
    </div>
    <p class="mt-2 text-xs text-slate-500">
      Dual-axis step chart: black = cumulative posts, green = cumulative income over the selected
      range.
    </p>
  </div>
</AdminLayout>
