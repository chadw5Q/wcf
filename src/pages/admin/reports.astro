---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllOrders } from '../../lib/orders';
import { getOrdersKvFromLocals } from '../../lib/orders-kv';
import { formatUsd } from '../../lib/format-order';
import { getProductsConfig } from '../../lib/products-config';
import {
  buildCumulativeSeries,
  defaultReportRangeYmd,
  filterOrdersByCentralDateRange,
  formatAxisMoney,
  isYtdRange,
  niceAxisMax,
  reportSeasons,
  summarizeOrdersForReport,
  summarizeProductSales,
  type ProductSalesMetric,
  type ProductSalesRow,
} from '../../lib/reports';

const kv = getOrdersKvFromLocals(Astro.locals);
const kvMissing = !kv;
const allOrders = kv ? await getAllOrders(kv) : [];

const defaults = defaultReportRangeYmd();
const fromParam = Astro.url.searchParams.get('from')?.trim() || defaults.from;
const toParam = Astro.url.searchParams.get('to')?.trim() || defaults.to;
const rangeIsYtd = isYtdRange(fromParam, toParam);
const seasons = reportSeasons();
const activeSeason = seasons.find((s) => s.from === fromParam && s.to === toParam)?.season ?? null;
const rangeIsCustom = !rangeIsYtd && activeSeason === null;
const metricParam = Astro.url.searchParams.get('metric')?.trim().toLowerCase();
const metric: ProductSalesMetric = metricParam === 'volume' ? 'volume' : 'dollars';

const inRange = kvMissing
  ? []
  : filterOrdersByCentralDateRange(allOrders, fromParam, toParam);

const summary = summarizeOrdersForReport(inRange);
const productsConfig = await getProductsConfig(kv);
const productLabels = Object.fromEntries(
  productsConfig.orderSkus.map((sku) => [sku.fieldName, sku.label])
);
const productSales = summarizeProductSales(inRange, { metric, labels: productLabels });
const chartPoints = buildCumulativeSeries(inRange, {
  rangeFrom: fromParam,
  rangeTo: toParam,
  padDays: 5,
});

function formatPosts(n: number): string {
  return `${n.toLocaleString('en-US')} posts`;
}

const chartW = 720;
const chartH = 280;
const pad = { top: 24, right: 56, bottom: 40, left: 48 };
const plotW = chartW - pad.left - pad.right;
const plotH = chartH - pad.top - pad.bottom;

const maxPostsRaw = chartPoints.length
  ? Math.max(...chartPoints.map((p) => p.posts))
  : 0;
const maxIncomeRaw = chartPoints.length
  ? Math.max(...chartPoints.map((p) => p.income))
  : 0;
const maxPosts = niceAxisMax(maxPostsRaw);
const maxIncome = niceAxisMax(maxIncomeRaw);

function xAt(i: number, n: number): number {
  if (n <= 1) return pad.left + plotW / 2;
  return pad.left + (i / (n - 1)) * plotW;
}
function yPosts(v: number): number {
  return pad.top + plotH - (v / maxPosts) * plotH;
}
function yIncome(v: number): number {
  return pad.top + plotH - (v / maxIncome) * plotH;
}

function stepPath(
  values: number[],
  yFn: (v: number) => number
): string {
  if (values.length === 0) return '';
  let d = '';
  const n = values.length;
  for (let i = 0; i < n; i++) {
    const x = xAt(i, n);
    const y = yFn(values[i]!);
    if (i === 0) {
      d += `M ${x} ${y}`;
    } else {
      d += ` L ${x} ${yFn(values[i - 1]!)} L ${x} ${y}`;
    }
  }
  return d;
}

const pointCount = chartPoints.length;
const postsPath = stepPath(
  chartPoints.map((p) => p.posts),
  yPosts
);
const incomePath = stepPath(
  chartPoints.map((p) => p.income),
  yIncome
);

const labelStep = Math.max(1, Math.ceil(pointCount / 6));
const chartLabels = chartPoints
  .map((p, i) => ({
    ...p,
    x: xAt(i, pointCount),
    show: !(pointCount > 8) || i === 0 || i === pointCount - 1 || i % labelStep === 0,
  }))
  .filter((p) => p.show);

function reportHref(rangeFrom: string, rangeTo: string, nextMetric: ProductSalesMetric): string {
  const params = new URLSearchParams();
  params.set('from', rangeFrom);
  params.set('to', rangeTo);
  if (nextMetric === 'volume') params.set('metric', 'volume');
  return `?${params.toString()}`;
}

const ytdHref = reportHref(defaults.from, defaults.to, metric);
const seasonLinks = seasons.map((s) => ({
  ...s,
  href: reportHref(s.from, s.to, metric),
  active: s.season === activeSeason,
}));
const dollarsHref = reportHref(fromParam, toParam, 'dollars');
const volumeHref = reportHref(fromParam, toParam, 'volume');

const productMetricMax = productSales.reduce((max, row) => {
  const value = metric === 'volume' ? row.volume : row.dollars;
  return Math.max(max, value);
}, 0);

function productBarPercent(row: ProductSalesRow): number {
  if (productMetricMax <= 0) return 0;
  const value = metric === 'volume' ? row.volume : row.dollars;
  return (value / productMetricMax) * 100;
}

function formatProductMetric(row: ProductSalesRow): string {
  return metric === 'volume' ? row.volume.toLocaleString('en-US') : formatUsd(row.dollars);
}

function formatVolume(n: number): string {
  return n.toLocaleString('en-US');
}
---

<AdminLayout title="Reports — Admin">
  {
    kvMissing && (
      <div class="no-print mb-6 rounded border border-amber-300 bg-amber-50 px-4 py-3 text-amber-900">
        <strong>ORDERS_KV is not bound.</strong> Reports are unavailable until KV is configured.
      </div>
    )
  }

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900">Reports</h1>
    <p class="mt-1 text-sm text-slate-600">
      Order posts and income by status. Dates use America/Chicago calendar days. Income is order
      totals after volume discount.
    </p>
  </div>

  <!-- Date range -->
  <div class="no-print mb-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <form method="get" class="flex flex-wrap items-end gap-3">
      {metric === 'volume' && <input type="hidden" name="metric" value="volume" />}
      <div class="flex flex-wrap gap-2">
        <a
          href={ytdHref}
          class:list={[
            'rounded px-3 py-2 text-sm font-medium',
            rangeIsYtd
              ? 'bg-green-700 text-white'
              : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50',
          ]}
          aria-current={rangeIsYtd ? 'page' : undefined}
        >
          This YTD
        </a>
        {
          seasonLinks.map((s) => (
            <a
              href={s.href}
              class:list={[
                'rounded px-3 py-2 text-sm font-medium',
                s.active
                  ? 'bg-green-700 text-white'
                  : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50',
              ]}
              aria-current={s.active ? 'page' : undefined}
              title={`${s.from} to ${s.to}`}
            >
              {s.season} Season
            </a>
          ))
        }
        <span
          class:list={[
            'rounded px-3 py-2 text-sm font-medium',
            rangeIsCustom
              ? 'bg-slate-800 text-white'
              : 'border border-slate-300 bg-white text-slate-500',
          ]}
        >
          Custom
        </span>
      </div>
      <div>
        <label for="from" class="mb-1 block text-xs font-medium text-slate-600">From</label>
        <input
          id="from"
          name="from"
          type="date"
          required
          value={fromParam}
          class="min-h-11 rounded border border-slate-300 px-3 py-2 text-base text-slate-900"
        />
      </div>
      <div>
        <label for="to" class="mb-1 block text-xs font-medium text-slate-600">To</label>
        <input
          id="to"
          name="to"
          type="date"
          required
          value={toParam}
          class="min-h-11 rounded border border-slate-300 px-3 py-2 text-base text-slate-900"
        />
      </div>
      <button
        type="submit"
        class="min-h-11 rounded bg-green-700 px-4 py-2 text-sm font-medium text-white hover:bg-green-800"
      >
        Apply
      </button>
    </form>
    <p class="mt-3 text-xs text-slate-500">
      Showing <span class="font-medium text-slate-700">{fromParam}</span> →
      <span class="font-medium text-slate-700">{toParam}</span>
      {rangeIsYtd ? ' (year to date)' : activeSeason !== null ? ` (${activeSeason} Season)` : ''}
      {' · '}
      {inRange.length} order{inRange.length === 1 ? '' : 's'}
    </p>
  </div>

  <!-- Summary cards -->
  <div class="mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Total</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">
        {formatPosts(summary.total.posts)}
      </div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(summary.total.income)}
      </div>
      <p class="mt-2 text-xs text-slate-500">
        All orders in range ({summary.total.orderCount})
      </p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Scheduled</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">
        {formatPosts(summary.open.posts)}
      </div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(summary.open.income)}
      </div>
      <p class="mt-2 text-xs text-slate-500">
        Pending / scheduled — not yet fulfilled ({summary.open.orderCount})
      </p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Fulfilled</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">
        {formatPosts(summary.fulfilled.posts)}
      </div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(summary.fulfilled.income)}
      </div>
      <p class="mt-2 text-xs text-slate-500">
        Marked fulfilled ({summary.fulfilled.orderCount})
      </p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Canceled</div>
      <div class="mt-3 text-2xl font-bold tabular-nums text-slate-900">
        {formatPosts(summary.canceled.posts)}
      </div>
      <div class="mt-1 text-xl font-semibold tabular-nums text-green-800">
        {formatUsd(summary.canceled.income)}
      </div>
      <p class="mt-2 text-xs text-slate-500">
        Marked canceled ({summary.canceled.orderCount})
      </p>
    </div>
  </div>

  <!-- Cumulative chart -->
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-semibold text-slate-900">Cumulative</h2>
      <div class="flex flex-wrap gap-4 text-sm">
        <span class="inline-flex items-center gap-2 text-slate-700">
          <span class="inline-block h-0.5 w-6 bg-slate-900" aria-hidden="true"></span>
          # Posts
        </span>
        <span class="inline-flex items-center gap-2 text-green-800">
          <span class="inline-block h-0.5 w-6 bg-green-700" aria-hidden="true"></span>
          $ Income
        </span>
      </div>
    </div>

    {
      chartPoints.length === 0 ? (
        <p class="py-12 text-center text-sm text-slate-500">
          No orders in this date range yet.
        </p>
      ) : (
        <div class="w-full overflow-x-auto">
          <svg
            viewBox={`0 0 ${chartW} ${chartH}`}
            class="min-w-[20rem] w-full"
            role="img"
            aria-label="Cumulative step chart of posts and income over time"
          >
            {[0, 0.25, 0.5, 0.75, 1].map((t) => {
              const y = pad.top + plotH * (1 - t);
              return (
                <line
                  x1={pad.left}
                  x2={pad.left + plotW}
                  y1={y}
                  y2={y}
                  stroke="#e2e8f0"
                  stroke-width="1"
                />
              );
            })}

            <line
              x1={pad.left}
              x2={pad.left}
              y1={pad.top}
              y2={pad.top + plotH}
              stroke="#94a3b8"
              stroke-width="1.5"
            />
            <line
              x1={pad.left + plotW}
              x2={pad.left + plotW}
              y1={pad.top}
              y2={pad.top + plotH}
              stroke="#94a3b8"
              stroke-width="1.5"
            />
            <line
              x1={pad.left}
              x2={pad.left + plotW}
              y1={pad.top + plotH}
              y2={pad.top + plotH}
              stroke="#94a3b8"
              stroke-width="1.5"
            />

            <text
              x={pad.left - 8}
              y={pad.top + 4}
              text-anchor="end"
              class="fill-slate-600 text-[10px]"
            >
              {maxPosts.toLocaleString('en-US')}
            </text>
            <text
              x={pad.left - 8}
              y={pad.top + plotH / 2}
              text-anchor="end"
              class="fill-slate-600 text-[10px]"
            >
              {Math.round(maxPosts / 2).toLocaleString('en-US')}
            </text>
            <text
              x={pad.left - 8}
              y={pad.top + plotH}
              text-anchor="end"
              class="fill-slate-600 text-[10px]"
            >
              0
            </text>
            <text
              x={14}
              y={pad.top + plotH / 2}
              text-anchor="middle"
              transform={`rotate(-90 14 ${pad.top + plotH / 2})`}
              class="fill-slate-700 text-[11px] font-medium"
            >
              # Posts
            </text>

            <text
              x={pad.left + plotW + 8}
              y={pad.top + 4}
              text-anchor="start"
              class="fill-green-800 text-[10px]"
            >
              {formatAxisMoney(maxIncome)}
            </text>
            <text
              x={pad.left + plotW + 8}
              y={pad.top + plotH / 2}
              text-anchor="start"
              class="fill-green-800 text-[10px]"
            >
              {formatAxisMoney(maxIncome / 2)}
            </text>
            <text
              x={pad.left + plotW + 8}
              y={pad.top + plotH}
              text-anchor="start"
              class="fill-green-800 text-[10px]"
            >
              $0
            </text>
            <text
              x={chartW - 12}
              y={pad.top + plotH / 2}
              text-anchor="middle"
              transform={`rotate(90 ${chartW - 12} ${pad.top + plotH / 2})`}
              class="fill-green-800 text-[11px] font-medium"
            >
              $ Income
            </text>

            <path d={incomePath} fill="none" stroke="#15803d" stroke-width="2.5" />
            <path d={postsPath} fill="none" stroke="#0f172a" stroke-width="2.5" />

            {
              chartLabels.map((p) => (
                <text
                  x={p.x}
                  y={chartH - 12}
                  text-anchor="middle"
                  class="fill-slate-600 text-[10px]"
                >
                  {p.label}
                </text>
              ))
            }
          </svg>
        </div>
      )
    }
    <p class="mt-2 text-xs text-slate-500">
      Dual-axis step chart by order date (Central): black = cumulative posts (excludes bow stave
      logs), green = cumulative income.
    </p>
  </div>

  <!-- Product sales -->
  <div class="mt-10 rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h2 id="product-sales-heading" class="text-lg font-semibold text-slate-900">Sales by product</h2>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Sales metric">
        <a
          href={dollarsHref}
          class:list={[
            'inline-flex items-center rounded border px-3 py-2 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800',
            metric === 'dollars'
              ? 'border-green-700 bg-green-700 text-white'
              : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50',
          ]}
          aria-current={metric === 'dollars' ? 'true' : undefined}
        >
          Dollars
        </a>
        <a
          href={volumeHref}
          class:list={[
            'inline-flex items-center rounded border px-3 py-2 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-800',
            metric === 'volume'
              ? 'border-green-700 bg-green-700 text-white'
              : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50',
          ]}
          aria-current={metric === 'volume' ? 'true' : undefined}
        >
          Volume
        </a>
      </div>
    </div>

    {
      productSales.length === 0 ? (
        <p class="py-12 text-center text-sm text-slate-500">No product sales in this date range.</p>
      ) : (
        <div class="space-y-4" aria-hidden="true">
          {productSales.map((row) => (
            <div>
              <div class="mb-1 flex items-baseline justify-between gap-3">
                <span class="min-w-0 text-sm font-medium text-slate-800">{row.label}</span>
                <span class="shrink-0 text-sm font-semibold tabular-nums text-green-800">
                  {formatProductMetric(row)}
                </span>
              </div>
              <div class="h-3 overflow-hidden rounded bg-slate-100">
                <div
                  class="h-full rounded bg-green-700"
                  style={`width: ${productBarPercent(row)}%`}
                />
              </div>
            </div>
          ))}
        </div>
      )
    }

    {
      productSales.length > 0 && (
        <table class="mt-6 w-full border-collapse text-sm">
          <caption
            id="product-sales-caption"
            class="caption-bottom mt-3 text-left text-xs font-normal text-slate-500"
          >
            Dollars are each product’s share of order income after volume discount, split by
            pre-discount line total. Volume is units sold and includes bow staves. Every order in
            the date range is included, including canceled — the same orders as Total.
          </caption>
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
              <th scope="col" class="py-2 pr-4 font-semibold">Product</th>
              <th scope="col" class="py-2 pr-4 text-right font-semibold">Dollars</th>
              <th scope="col" class="py-2 text-right font-semibold">Volume</th>
            </tr>
          </thead>
          <tbody>
            {productSales.map((row) => (
              <tr class="border-b border-slate-100">
                <th scope="row" class="py-2 pr-4 text-left font-medium text-slate-800">
                  {row.label}
                </th>
                <td
                  class:list={[
                    'py-2 pr-4 text-right tabular-nums',
                    metric === 'dollars' ? 'font-semibold text-green-800' : 'text-slate-700',
                  ]}
                >
                  {formatUsd(row.dollars)}
                </td>
                <td
                  class:list={[
                    'py-2 text-right tabular-nums',
                    metric === 'volume' ? 'font-semibold text-green-800' : 'text-slate-700',
                  ]}
                >
                  {formatVolume(row.volume)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
    {
      productSales.length === 0 && (
        <p class="mt-2 text-xs text-slate-500">
          Dollars are each product’s share of order income after volume discount. Volume is units
          sold, including bow staves. Canceled orders are included, matching Total.
        </p>
      )
    }
  </div>
</AdminLayout>
