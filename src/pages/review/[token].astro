---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getOrder } from '../../lib/orders';
import { getOrdersKvFromLocals } from '../../lib/orders-kv';
import { defaultDisplayName } from '../../lib/reviews';
import { findReviewByOrderId } from '../../lib/reviews';
import { getReviewsKvFromLocals } from '../../lib/reviews-kv';
import { verifyReviewToken } from '../../lib/review-token';

const rawToken = Astro.params.token ?? '';
let token = rawToken;
try {
  token = decodeURIComponent(rawToken);
} catch {
  token = rawToken;
}

const payload = await verifyReviewToken(token);
const ordersKv = getOrdersKvFromLocals(Astro.locals);
const reviewsKv = getReviewsKvFromLocals(Astro.locals);
const order = payload && ordersKv ? await getOrder(ordersKv, payload.orderId) : null;
const existing =
  order && reviewsKv ? await findReviewByOrderId(reviewsKv, order.id) : null;

const rParam = Number(Astro.url.searchParams.get('r'));
const preselected = Number.isInteger(rParam) && rParam >= 1 && rParam <= 5 ? rParam : 0;
const suggestedName = order ? defaultDisplayName(order, false) : '';
const firstName = order?.customer.firstName?.trim() || '';
---

<Layout title={order ? `Review your posts — Williams Creek Farms` : 'Review link'}>
  <section class="mx-auto max-w-xl px-4 py-12 sm:px-6">
    {
      !payload || !order ? (
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
          <h1 class="text-2xl font-bold text-slate-900">This link isn’t valid</h1>
          <p class="mt-3 text-slate-600">
            It may have expired or already been used. Call or text Chad at{' '}
            <a href="tel:+17122543999" class="font-medium text-green-700 underline">712-254-3999</a> if you need help.
          </p>
        </div>
      ) : existing ? (
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
          <h1 class="text-2xl font-bold text-slate-900">Thanks — we already have your review</h1>
          <p class="mt-3 text-slate-600">
            You rated us {existing.rating} star{existing.rating === 1 ? '' : 's'}
            {existing.comment ? ` and said: “${existing.comment}”` : ''}.
          </p>
          <p class="mt-4 text-sm text-slate-500">No need to submit again.</p>
        </div>
      ) : (
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-green-800">Williams Creek Farms</p>
          <h1 class="mt-2 text-3xl font-bold text-slate-900">How did the posts working for you?</h1>
          <p class="mt-2 text-slate-600">
            Thanks again, {firstName || 'friend'}. One tap on the stars is plenty — a short note or photo is optional.
          </p>

          <form id="review-form" class="mt-8 space-y-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <input type="hidden" name="token" value={token} />

            <fieldset>
              <legend class="text-sm font-semibold text-slate-800">Your rating</legend>
              <div class="mt-3 flex gap-2" id="star-row" role="radiogroup" aria-label="Star rating">
                {[1, 2, 3, 4, 5].map((n) => (
                  <label class="cursor-pointer">
                    <input
                      type="radio"
                      name="rating"
                      value={n}
                      class="peer sr-only"
                      required
                      checked={preselected === n}
                    />
                    <span
                      class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 text-2xl text-slate-300 peer-checked:border-amber-400 peer-checked:bg-amber-50 peer-checked:text-amber-500 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-green-700"
                      aria-hidden="true"
                    >
                      ★
                    </span>
                    <span class="sr-only">{n} star{n === 1 ? '' : 's'}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <div>
              <label for="comment" class="text-sm font-semibold text-slate-800">
                Comment <span class="font-normal text-slate-500">(optional)</span>
              </label>
              <textarea
                id="comment"
                name="comment"
                rows="4"
                maxlength="2000"
                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
                placeholder="How did the posts working for you? Anything about the pickup?"
              ></textarea>
            </div>

            <div>
              <label for="displayName" class="text-sm font-semibold text-slate-800">How should we show your name?</label>
              <input
                id="displayName"
                name="displayName"
                required
                value={suggestedName}
                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
              />
              <label class="mt-2 flex items-center gap-2 text-sm text-slate-600">
                <input id="firstNameOnly" name="firstNameOnly" type="checkbox" value="1" class="rounded border-slate-300" />
                Just my first name
              </label>
            </div>

            <div>
              <label for="location" class="text-sm font-semibold text-slate-800">
                Town, state <span class="font-normal text-slate-500">(optional)</span>
              </label>
              <input
                id="location"
                name="location"
                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
                placeholder="e.g. Sheridan, MO"
                autocomplete="address-level2"
              />
            </div>

            <div>
              <label for="photo" class="text-sm font-semibold text-slate-800">
                Photo <span class="font-normal text-slate-500">(optional)</span>
              </label>
              <input
                id="photo"
                name="photo"
                type="file"
                accept="image/*,.heic,.heif"
                class="mt-1 block w-full text-sm text-slate-600"
              />
              <p class="mt-1 text-xs text-slate-500">
                We’ll resize it on your phone before upload. GPS location is stripped automatically.
              </p>
              <p id="photo-status" class="mt-1 hidden text-xs text-green-700"></p>
            </div>

            <p id="form-error" class="hidden text-sm text-red-700" role="alert"></p>

            <button
              id="submit-btn"
              type="submit"
              class="w-full rounded-lg bg-green-700 px-4 py-3 text-base font-semibold text-white hover:bg-green-800"
            >
              Submit review
            </button>
          </form>
        </div>
      )
    }
  </section>
</Layout>

{
  order && !existing && payload && (
    <script define:vars={{ firstNameDefault: order.customer.firstName?.trim() || '', suggestedName }}>
      const form = document.getElementById('review-form');
      const firstOnly = document.getElementById('firstNameOnly');
      const displayName = document.getElementById('displayName');
      const photoInput = document.getElementById('photo');
      const photoStatus = document.getElementById('photo-status');
      const errEl = document.getElementById('form-error');
      const submitBtn = document.getElementById('submit-btn');
      let photoBlob = null;

      firstOnly?.addEventListener('change', () => {
        if (!(displayName instanceof HTMLInputElement)) return;
        if (firstOnly instanceof HTMLInputElement && firstOnly.checked) {
          displayName.value = firstNameDefault || displayName.value.split(/\s+/)[0] || '';
        } else {
          displayName.value = suggestedName;
        }
      });

      async function readOrientation(file) {
        try {
          const buf = await file.slice(0, 64 * 1024).arrayBuffer();
          const view = new DataView(buf);
          if (view.getUint16(0, false) !== 0xffd8) return 1;
          let offset = 2;
          while (offset < view.byteLength) {
            if (view.getUint16(offset, false) === 0xffe1) {
              const exifStart = offset + 4;
              if (view.getUint32(exifStart, false) !== 0x45786966) return 1;
              const little = view.getUint16(exifStart + 6, false) === 0x4949;
              const tiff = exifStart + 6;
              const tags = view.getUint32(tiff + 4, little);
              const dir = tiff + tags;
              const entries = view.getUint16(dir, little);
              for (let i = 0; i < entries; i++) {
                const entry = dir + 2 + i * 12;
                if (view.getUint16(entry, little) === 0x0112) {
                  return view.getUint16(entry + 8, little);
                }
              }
              return 1;
            }
            offset += 2 + view.getUint16(offset + 2, false);
          }
        } catch {
          /* ignore */
        }
        return 1;
      }

      function drawOriented(img, orientation, maxEdge) {
        let w = img.naturalWidth;
        let h = img.naturalHeight;
        const scale = Math.min(1, maxEdge / Math.max(w, h));
        w = Math.round(w * scale);
        h = Math.round(h * scale);
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        if (!ctx) return null;
        const swap = orientation >= 5 && orientation <= 8;
        canvas.width = swap ? h : w;
        canvas.height = swap ? w : h;
        switch (orientation) {
          case 2: ctx.transform(-1, 0, 0, 1, w, 0); break;
          case 3: ctx.transform(-1, 0, 0, -1, w, h); break;
          case 4: ctx.transform(1, 0, 0, -1, 0, h); break;
          case 5: ctx.transform(0, 1, 1, 0, 0, 0); break;
          case 6: ctx.transform(0, 1, -1, 0, h, 0); break;
          case 7: ctx.transform(0, -1, -1, 0, h, w); break;
          case 8: ctx.transform(0, -1, 1, 0, 0, w); break;
          default: break;
        }
        ctx.drawImage(img, 0, 0, w, h);
        return canvas;
      }

      photoInput?.addEventListener('change', async () => {
        photoBlob = null;
        if (!(photoInput instanceof HTMLInputElement) || !photoInput.files?.[0]) return;
        const file = photoInput.files[0];
        const orientation = await readOrientation(file);
        const url = URL.createObjectURL(file);
        try {
          const img = await new Promise((resolve, reject) => {
            const el = new Image();
            el.onload = () => resolve(el);
            el.onerror = reject;
            el.src = url;
          });
          const canvas = drawOriented(img, orientation, 2000);
          if (!canvas) return;
          photoBlob = await new Promise((resolve) =>
            canvas.toBlob((b) => resolve(b), 'image/jpeg', 0.82)
          );
          if (photoStatus && photoBlob) {
            const kb = Math.round(photoBlob.size / 1024);
            photoStatus.textContent = `Ready to upload (~${kb} KB).`;
            photoStatus.classList.remove('hidden');
          }
        } catch {
          if (photoStatus) {
            photoStatus.textContent = 'Could not process that photo. Try a different image.';
            photoStatus.classList.remove('hidden');
          }
        } finally {
          URL.revokeObjectURL(url);
        }
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!(form instanceof HTMLFormElement)) return;
        errEl?.classList.add('hidden');
        const fd = new FormData(form);
        if (photoBlob) {
          fd.set('photo', photoBlob, 'review.jpg');
        } else {
          fd.delete('photo');
        }
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting…';
        }
        try {
          const res = await fetch('/api/reviews/submit', { method: 'POST', body: fd });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            window.location.href = '/review/thank-you';
            return;
          }
          if (errEl) {
            errEl.textContent = data.error || 'Could not submit review';
            errEl.classList.remove('hidden');
          }
        } catch {
          if (errEl) {
            errEl.textContent = 'Network error';
            errEl.classList.remove('hidden');
          }
        } finally {
          if (submitBtn instanceof HTMLButtonElement) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit review';
          }
        }
      });
    </script>
  )
}
