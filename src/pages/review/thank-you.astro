    <p class="mt-4 text-lg text-slate-600">
      Your review is in. Chad will take a look before it goes on the site.
    </p>
    <p class="mt-8">
      <a href="/" class="font-semibold text-green-700 underline hover:text-green-900">Back to the homepage</a>
    </p>
  </section>
</Layout>
