---
import HuntFinalPaymentForm from '../../../components/hunt/HuntFinalPaymentForm.astro';
import HuntLayout from '../../../layouts/HuntLayout.astro';
import HuntCheckInstructions from '../../../components/hunt/HuntCheckInstructions.astro';
import { finalPaymentHuntYears } from '../../../lib/hunt-final-balance';
import { HUNT_VENMO_HANDLE } from '../../../lib/hunt-payment-info';

const years = finalPaymentHuntYears();
---

<HuntLayout title="Final payment — Williams Creek Whitetails">
  <section class="relative border-b border-hunt-border/80 bg-hunt-surface/50 px-4 py-12 md:px-6">
    <div class="mx-auto max-w-[560px]">
      <h1 class="font-hunt-heading text-3xl text-hunt-cream md:text-4xl">Make Your Final Hunt Payment</h1>
      <p class="mt-3 text-hunt-muted">Full balances are due July 1 of your hunt year.</p>
    </div>
  </section>

  <div class="mx-auto max-w-[560px] px-4 pt-10 md:px-6">
    <div class="rounded border border-hunt-border bg-hunt-surface p-5 text-hunt-cream/95">
      <p class="text-xs font-semibold uppercase tracking-wider text-hunt-gold">No-fee options</p>
      <p class="mt-3 text-sm">
        Venmo <strong>{HUNT_VENMO_HANDLE}</strong> with your last name and hunt year in the note, or mail a check.
      </p>
      <HuntCheckInstructions memo="Hunt balance" class="mt-3" />
    </div>
    <p class="mt-8 text-xs font-semibold uppercase tracking-wider text-hunt-muted">Or pay by card or bank (ACH)</p>
  </div>

  <HuntFinalPaymentForm years={years} />
</HuntLayout>
