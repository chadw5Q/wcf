---
const pathname = Astro.url.pathname;

const links = [
  { label: 'About', href: '/hunt' },
  { label: 'Reserve Your Hunt', href: '/hunt/reserve' },
  { label: 'Make Final Payment', href: '/hunt/final-payment' },
] as const;

function active(href: string): boolean {
  if (href === '/hunt') return pathname === '/hunt' || pathname === '/hunt/';
  return pathname === href || pathname.startsWith(`${href}/`);
}

const linkClass = (href: string) =>
  active(href)
    ? 'text-hunt-gold-light'
    : 'text-hunt-cream hover:text-hunt-gold-light';

/** Clears `hunt_session` and redirects to `/hunt/login`. */
const logoutHref = '/api/hunt-logout';
---

<div data-hunt-nav-root>
  <header
    class="sticky top-0 z-50 border-b border-hunt-border bg-hunt-surface/95 backdrop-blur-sm"
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
      <a href="/hunt" class="group flex items-center gap-2 text-hunt-gold transition-colors hover:text-hunt-gold-light">
        <svg
          class="h-7 w-7 shrink-0 opacity-90"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path
            d="M6 18c2-4 3.5-9 4-12 .5 3 2 8 4 12M9 10c1.5 2 3 3.5 5 5M12 6v14"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
          <path
            d="M18 18c-2-4-3.5-9-4-12-.5 3-2 8-4 12M15 10c-1.5 2-3 3.5-5 5M12 6v14"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
        </svg>
        <span class="font-hunt-heading text-lg font-semibold tracking-tight md:text-xl">
          Williams Creek Whitetails
        </span>
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Hunt section">
        {
          links.map(({ label, href }) => (
            <a href={href} class={`text-sm font-medium uppercase tracking-wider ${linkClass(href)}`}>
              {label}
            </a>
          ))
        }
        <a
          href={logoutHref}
          class="text-sm font-medium uppercase tracking-wider text-hunt-muted hover:text-hunt-gold-light"
        >
          Logout
        </a>
      </nav>

      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded border border-hunt-border text-hunt-cream md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        data-hunt-nav-toggle
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </header>

  <div
    class="fixed inset-0 z-[100] hidden flex-col bg-hunt-bg/98 backdrop-blur-sm md:hidden"
    data-hunt-nav-panel
    aria-hidden="true"
  >
    <div class="flex justify-end border-b border-hunt-border px-4 py-3">
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded border border-hunt-border text-hunt-cream"
        aria-label="Close menu"
        data-hunt-nav-close
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="flex flex-1 flex-col items-center justify-center gap-8 px-6 text-center" aria-label="Hunt section mobile">
      {
        links.map(({ label, href }) => (
          <a
            href={href}
            class={`font-hunt-heading text-xl ${active(href) ? 'text-hunt-gold-light' : 'text-hunt-cream'}`}
            data-hunt-nav-link
          >
            {label}
          </a>
        ))
      }
      <a
        href={logoutHref}
        class="font-hunt-heading text-xl text-hunt-muted"
        data-hunt-nav-link
      >
        Logout
      </a>
    </nav>
  </div>
</div>

<script>
  function setupHuntNav() {
    const root = document.querySelector('[data-hunt-nav-root]');
    const toggle = root?.querySelector('[data-hunt-nav-toggle]');
    const panel = root?.querySelector('[data-hunt-nav-panel]');
    const closeBtn = root?.querySelector('[data-hunt-nav-close]');
    const navLinks = root?.querySelectorAll('[data-hunt-nav-link]');

    if (!root || !toggle || !panel || !(toggle instanceof HTMLButtonElement)) return;

    const open = () => {
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      toggle.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      panel.classList.add('hidden');
      panel.classList.remove('flex');
      toggle.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) close();
      else open();
    });

    closeBtn?.addEventListener('click', close);

    navLinks?.forEach((link) => link.addEventListener('click', close));

    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (toggle.getAttribute('aria-expanded') === 'true') close();
    });
  }

  setupHuntNav();
</script>
