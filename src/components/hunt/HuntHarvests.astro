---
import { featuredHarvestPhotos, harvestPhotos } from '../../lib/hunt-landing-content';
---

<section class="border-t border-hunt-border bg-hunt-surface/30 py-16 md:py-24" aria-labelledby="hunt-harvests-heading">
  <div class="mx-auto max-w-[900px] px-4 sm:px-5 md:px-6">
    <h2 id="hunt-harvests-heading" class="font-hunt-heading text-3xl text-hunt-gold md:text-4xl">Recent Harvests</h2>
    <p class="mt-3 text-hunt-cream/90">
      Bucks taken on Williams Creek ground. Our no-wound policy means your hunt isn&apos;t over until we tag your deer.
    </p>
  </div>

  <div class="mx-auto mt-10 max-w-6xl px-4 sm:px-5 md:px-6">
    <ul class="mb-3 grid gap-3 sm:mb-4 sm:grid-cols-3 sm:gap-4">
      {
        featuredHarvestPhotos.map((photo) => (
          <li class="overflow-hidden rounded border border-hunt-border bg-hunt-surface">
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] h-full w-full object-cover"
            />
          </li>
        ))
      }
    </ul>
    <ul class="columns-2 gap-3 sm:gap-4 lg:columns-3">
      {
        harvestPhotos.map((photo) => (
          <li class="mb-3 break-inside-avoid overflow-hidden rounded border border-hunt-border bg-hunt-surface sm:mb-4">
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
              class="h-auto w-full"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
