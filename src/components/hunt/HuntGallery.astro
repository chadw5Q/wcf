---
import { buckSeasons, galleryCaption } from '../../lib/hunt-landing-content';
---

<section
  id="the-bucks"
  class="scroll-mt-24 border-t border-hunt-border bg-hunt-bg py-16 md:py-24"
  aria-labelledby="hunt-gallery-heading"
>
  <div class="mx-auto max-w-[900px] px-4 sm:px-5 md:px-6">
    <h2 id="hunt-gallery-heading" class="font-hunt-heading text-3xl text-hunt-gold md:text-4xl">
      The Bucks We&apos;re Managing
    </h2>
    <p class="mt-3 text-hunt-cream/90">{galleryCaption}</p>
    <p class="mt-2 text-sm text-hunt-muted">Straight off our trail cameras, season by season.</p>
  </div>

  <div class="mx-auto mt-12 max-w-6xl space-y-12 px-4 sm:px-5 md:px-6">
    {
      buckSeasons.map(({ year, photos }) => (
        <div>
          <h3 class="flex items-center gap-4 font-hunt-heading text-2xl text-hunt-gold-light">
            {year}
            <span class="h-px flex-1 bg-hunt-border" aria-hidden="true" />
          </h3>
          <ul class="mt-5 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {photos.map((photo) => (
              <li class="overflow-hidden rounded border border-hunt-border bg-hunt-surface">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 motion-safe:hover:scale-105"
                />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
