---
import { getOrderSkuGalleryImages, type OrderSkuRow } from '../lib/products-config';

interface Props {
  sku: OrderSkuRow;
  variant: 'premium' | 'regular' | 'bow' | 'discount';
  /** Override the card's photos; defaults to the curated gallery for this SKU. */
  images?: string[];
}

const { sku, variant, images } = Astro.props;

const rawBullets = sku.shortDescription
  .split(',')
  .map((s) => s.trim())
  .filter(Boolean);
const bullets =
  rawBullets.length > 0 ? rawBullets : [sku.shortDescription.trim() || 'See order form for details.'];

const priceText = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(
  sku.unitPrice
);

const galleryImages = (images && images.length > 0
  ? images
  : getOrderSkuGalleryImages(sku, sku.fieldName)
).slice(0, 2);
const alt = `${sku.label} — ${sku.shortDescription}`;

const cardClass =
  variant === 'regular'
    ? 'rounded-xl p-6 border border-yellow-400'
    : variant === 'discount'
      ? 'rounded-xl p-6 border-2 border-amber-500'
      : 'rounded-xl p-6 border border-green-400';

const cardStyle =
  variant === 'regular'
    ? 'background-color: #fff5d1;'
    : variant === 'discount'
      ? 'background-color: #ffedd5;'
      : 'background-color: #b8f1c5;';

const ctaClass =
  variant === 'regular'
    ? 'w-full bg-yellow-600 text-white text-center py-2 px-4 rounded-lg hover:bg-yellow-700 transition-colors duration-200 block font-medium'
    : variant === 'discount'
      ? 'w-full bg-amber-600 text-white text-center py-2 px-4 rounded-lg hover:bg-amber-700 transition-colors duration-200 block font-medium'
      : 'w-full bg-green-600 text-white text-center py-2 px-4 rounded-lg hover:bg-green-700 transition-colors duration-200 block font-medium';

const priceColor = variant === 'discount' ? 'text-amber-700' : variant === 'regular' ? 'text-green-600' : 'text-green-700';
---

<div class={cardClass} style={cardStyle}>
  {
    (sku.soldOut || variant === 'premium' || variant === 'discount') && (
      <div
        class:list={[
          'mb-3 flex flex-wrap items-center gap-2',
          sku.soldOut ? 'justify-between' : 'justify-end',
        ]}
      >
        {sku.soldOut && (
          <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full shrink-0">SOLD OUT</span>
        )}
        {variant === 'premium' && (
          <span class="bg-green-600 text-white text-xs font-bold px-3 py-1 rounded-full shrink-0">PREMIUM</span>
        )}
        {variant === 'discount' && (
          <span class="bg-amber-600 text-white text-xs font-bold px-3 py-1 rounded-full shrink-0">DISCOUNT BIN</span>
        )}
      </div>
    )
  }
  <div class="text-center mb-4">
    <h4 class="text-xl font-bold text-gray-900 mb-2">{sku.label}</h4>
    <div class:list={['text-4xl font-bold mb-4', priceColor]}>
      {priceText}
    </div>
    {variant === 'bow' && <div class="text-gray-600">per log</div>}
    {variant === 'discount' && <div class="text-gray-600">each — while they last</div>}
  </div>
  <div class="flex flex-col gap-3">
    {
      galleryImages.map((src) => (
        <button
          type="button"
          class="js-card-photo block w-full cursor-zoom-in overflow-hidden rounded-lg ring-1 ring-black/5 transition hover:opacity-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700"
          data-full={src}
          data-alt={alt}
          aria-label={`Enlarge photo of ${sku.label}`}
        >
          <img
            src={src}
            alt={alt}
            class="aspect-[4/3] w-full object-cover"
            width="1200"
            height="900"
            loading="lazy"
          />
        </button>
      ))
    }
    <p class="text-center text-xs italic text-gray-600">
      Actual photos of what's for sale. Tap an image to enlarge.
    </p>
  </div>
  <ul class="mt-4 space-y-3">
    {
      bullets.map((text) => (
        <li class="flex items-center">
          <svg class="w-5 h-5 text-green-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-gray-700">{text}</span>
        </li>
      ))
    }
  </ul>
  {
    variant === 'bow' && (
      <div class="bg-white bg-opacity-50 rounded-lg p-3 mb-4 mt-4">
        <div class="flex items-center text-sm">
          <svg class="w-4 h-4 text-red-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"
            />
          </svg>
          <span class="text-gray-700">We cannot ship bow stave logs</span>
        </div>
      </div>
    )
  }
  <div class="mt-6">
    {
      sku.soldOut ? (
        <span
          class="w-full bg-gray-400 text-white text-center py-2 px-4 rounded-lg block font-medium cursor-not-allowed"
          aria-disabled="true"
        >
          Sold Out
        </span>
      ) : (
        <a href="/order-now" class={ctaClass}>
          Order Now
        </a>
      )
    }
  </div>
</div>

<script>
  // Shared lightbox for all product cards. Astro bundles this script once per page
  // even though the card component renders multiple times.
  function initCardPhotoLightbox() {
    const DIALOG_ID = 'card-photo-lightbox';
    let dialog = document.getElementById(DIALOG_ID);

    if (!(dialog instanceof HTMLDialogElement)) {
      dialog = document.createElement('dialog');
      dialog.id = DIALOG_ID;
      dialog.setAttribute('closedby', 'any');
      dialog.setAttribute('aria-label', 'Enlarged product photo');
      dialog.className =
        'm-auto max-h-[90vh] max-w-[92vw] rounded-lg bg-transparent p-0 backdrop:bg-black/70';
      dialog.innerHTML = `
        <div class="relative">
          <img alt="" class="max-h-[88vh] max-w-[92vw] rounded-lg object-contain" />
          <button type="button" data-close aria-label="Close"
            class="absolute right-2 top-2 flex h-9 w-9 items-center justify-center rounded-full bg-black/60 text-xl leading-none text-white hover:bg-black/80">&times;</button>
        </div>`;
      document.body.appendChild(dialog);

      const dlg = dialog;

      dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
      // Clicking the image itself also closes.
      dlg.querySelector('img')?.addEventListener('click', () => dlg.close());

      // Fallback light-dismiss for browsers without `closedby` (e.g. Safari):
      // close when the click lands on the backdrop rather than the content.
      if (!('closedBy' in HTMLDialogElement.prototype)) {
        dlg.addEventListener('click', (event) => {
          if (event.target === dlg) dlg.close();
        });
      }
    }

    const dlg = dialog as HTMLDialogElement;
    const dlgImg = dlg.querySelector('img');

    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      const trigger = target?.closest('.js-card-photo');
      if (!(trigger instanceof HTMLElement)) return;
      const full = trigger.getAttribute('data-full');
      if (!full || !(dlgImg instanceof HTMLImageElement)) return;
      dlgImg.src = full;
      dlgImg.alt = trigger.getAttribute('data-alt') || '';
      dlg.showModal();
    });
  }

  initCardPhotoLightbox();
</script>
