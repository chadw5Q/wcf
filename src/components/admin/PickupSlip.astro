---
/** One printable page: what a hedge customer still owes when they pick up. */
import type { StoredOrder } from '../../lib/order-types';
import { formatCentralDateTime, formatUsd } from '../../lib/format-order';
import { normalizeVolumeDiscount, volumeDiscountLabel } from '../../lib/orders';
import { amountStillOwed, depositCredited, depositState } from '../../lib/deposits';
import { hedgePayRailLabel } from '../../lib/hedge-deposit';

interface Props {
  order: StoredOrder;
}

const { order } = Astro.props;
const discount = normalizeVolumeDiscount(order.volumeDiscount);
const discountLabel = discount.applied && discount.amount > 0 ? volumeDiscountLabel(discount) : null;
const state = depositState(order);
const credited = depositCredited(order);
const owed = amountStillOwed(order);
const today = new Date().toLocaleDateString('en-US', {
  timeZone: 'America/Chicago',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="pickup-slip mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white p-6 text-slate-900 shadow-sm print:max-w-none print:border-0 print:p-0 print:shadow-none">
  <header class="flex items-start justify-between gap-4 border-b-2 border-slate-800 pb-3">
    <div>
      <p class="text-xl font-bold">Southwest Iowa Hedge</p>
      <p class="text-sm text-slate-600">Williams Creek Farms · 712-254-3999</p>
    </div>
    <div class="text-right text-sm">
      <p class="font-semibold uppercase tracking-wide">Pickup balance</p>
      <p>{today}</p>
      <p class="text-slate-600">Order {order.id.slice(0, 8)}</p>
    </div>
  </header>

  <section class="mt-4 grid gap-1 text-sm sm:grid-cols-2">
    <div>
      <p class="text-lg font-semibold">{order.customer.name}</p>
      {order.customer.phone?.trim() && <p class="tabular-nums">{order.customer.phone.trim()}</p>}
      <p>{order.customer.email}</p>
    </div>
    <div class="sm:text-right">
      <p>Ordered {formatCentralDateTime(order.createdAt)}</p>
      {order.deliverySlot?.trim() && <p>Pickup: {order.deliverySlot.trim()}</p>}
    </div>
  </section>

  <table class="mt-4 w-full text-left text-sm">
    <thead class="border-b border-slate-400">
      <tr>
        <th class="py-2 font-semibold">Item</th>
        <th class="py-2 text-right font-semibold">Qty</th>
        <th class="py-2 text-right font-semibold">Each</th>
        <th class="py-2 text-right font-semibold">Total</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      {
        order.items
          .filter((i) => i.quantity > 0)
          .map((i) => (
            <tr>
              <td class="py-2">{i.product}</td>
              <td class="py-2 text-right tabular-nums">{i.quantity}</td>
              <td class="py-2 text-right tabular-nums">{formatUsd(i.unitPrice)}</td>
              <td class="py-2 text-right tabular-nums">{formatUsd(i.lineTotal)}</td>
            </tr>
          ))
      }
    </tbody>
  </table>

  <dl class="ml-auto mt-4 w-full max-w-xs space-y-1 text-sm">
    <div class="flex justify-between"><dt>Subtotal</dt><dd class="tabular-nums">{formatUsd(order.subtotal)}</dd></div>
    {
      discountLabel && (
        <div class="flex justify-between"><dt>{discountLabel}</dt><dd class="tabular-nums">−{formatUsd(discount.amount)}</dd></div>
      )
    }
    <div class="flex justify-between font-semibold"><dt>Order total</dt><dd class="tabular-nums">{formatUsd(order.discountedSubtotal)}</dd></div>
    {
      state === 'received' && (
        <div class="flex justify-between">
          <dt>Deposit paid{order.depositPayRail ? ` (${hedgePayRailLabel(order.depositPayRail).replace(/ \(.*\)$/, '')})` : ''}</dt>
          <dd class="tabular-nums">−{formatUsd(credited)}</dd>
        </div>
      )
    }
    <div class="flex items-baseline justify-between border-t-2 border-slate-800 pt-2 text-xl font-bold">
      <dt>Balance due</dt><dd class="tabular-nums">{formatUsd(owed)}</dd>
    </div>
  </dl>

  {
    state === 'pending' && (
      <p class="mt-3 rounded border border-amber-400 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        A {formatUsd(order.depositAmount)} deposit was chosen but has not been confirmed, so it is not
        subtracted above. If they paid it, collect {formatUsd(Math.max(0, owed - order.depositAmount))}.
      </p>
    )
  }

  <section class="mt-8 space-y-6 text-sm">
    <p>Paid by: &nbsp; ☐ Cash &nbsp; ☐ Check # ________ &nbsp; ☐ Venmo &nbsp; ☐ Card &nbsp;&nbsp; Amount $ __________</p>
    <div class="grid grid-cols-2 gap-8">
      <p class="border-t border-slate-500 pt-1">Customer signature</p>
      <p class="border-t border-slate-500 pt-1">Date</p>
    </div>
  </section>

  {
    order.notes?.trim() && (
      <p class="mt-6 text-xs text-slate-600"><strong>Notes:</strong> {order.notes.trim()}</p>
    )
  }
</article>
